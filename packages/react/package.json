{
  "name": "@mainmoneyapp/js-react",
  "version": "0.1.1",
  "description": "React checkout wizard for the MainMoney JS/TS frontend SDK",
  "type": "module",
  "license": "MIT",
  "author": "MainMoney SARL",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_js_sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MainMoney-Inc/mm_aggr_js_sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/MainMoney-Inc/mm_aggr_js_sdk/issues"
  },
  "keywords": [
    "mainmoney",
    "checkout",
    "payments",
    "react"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external react --external @mainmoneyapp/js-checkout"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@mainmoneyapp/js-checkout": "0.1.1"
  }
}
