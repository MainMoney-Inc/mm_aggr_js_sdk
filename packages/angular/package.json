{
  "name": "@mainmoney/js-angular",
  "version": "0.1.0",
  "description": "Angular checkout wizard for the MainMoney JS/TS frontend SDK",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "MainMoney SARL",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_js_sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MainMoney-Inc/mm_aggr_js_sdk.git",
    "directory": "packages/angular"
  },
  "sideEffects": false,
  "main": "./dist/fesm2022/mainmoney-js-angular.mjs",
  "module": "./dist/fesm2022/mainmoney-js-angular.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/mainmoney-js-angular.mjs"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json"
  },
  "peerDependencies": {
    "@angular/core": ">=17"
  },
  "dependencies": {
    "@mainmoney/js-checkout": "0.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.8.2"
  }
}
