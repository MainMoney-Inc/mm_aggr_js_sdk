{
  "name": "@mainmoney/js-vue",
  "version": "0.1.0",
  "description": "Vue checkout wizard for the MainMoney JS/TS frontend SDK",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "MainMoney SARL",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_js_sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MainMoney-Inc/mm_aggr_js_sdk.git",
    "directory": "packages/vue"
  },
  "main": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src/index.d.ts", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external vue --external @mainmoney/js-checkout"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@mainmoney/js-checkout": "0.1.0"
  }
}
